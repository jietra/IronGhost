# ============================
# IronGhost Service Config
# ============================

# --- Model configuration ---
MODEL_PATH=<path_to_your_model>
MODEL_TYPE=<optional_model_type>
CONTEXT_SIZE_REQUESTED=32768
N_THREADS=8
N_GPU_LAYERS=99

# --- Socket configuration ---
SOCKET_PATH=/tmp/sentinel_code.sock

# --- Prompt system file ---
SYSTEM_PROMPT=../src/config/system_prompt.txt

# --- Grammar file ---
GRAMMAR_STR=../src/config/grammar_str.gbnf

# --- Default generation parameters: for static behavior or initialization ---
# WARNING: can be confusing when parameters are changed at runtime (option not yet implemented).
TEMPERATURE=0.1
TOP_P=0.95
TOP_K=40
MIN_P=0.05
PENALTY_LAST_N=64
PENALTY_REPEAT=1.1
PENALTY_FREQ=0
PENALTY_PRESENT=0
#MAX_TOKENS=2048

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=../logs/logs.log

# --- Performance tuning ---
# 0 = disabled, 1 = enabled
USE_FLASH_ATTN=1
USE_PARALLEL_DECODE=1
USE_MMAP=1

# --- Safety / Debug ---
ENABLE_DEBUG=0
PRINT_PROMPT=0