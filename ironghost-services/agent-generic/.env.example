# ============================
# IronGhost Service Config
# ============================

# --- Model configuration ---
MODEL_PATH=<path_to_your_model>
MODEL_TYPE=<optional_model_type>
CONTEXT_SIZE_REQUESTED=32768
N_THREADS=8
N_GPU_LAYERS=99

# --- Socket configuration ---
SOCKET_PATH=/tmp/agent_generic.sock

# --- Prompt system file ---
SYSTEM_PROMPT=./src/prompts/system_agent_generic.txt

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=./logs/agent_generic.log

# --- Performance tuning ---
# 0 = disabled, 1 = enabled
USE_FLASH_ATTN=1
USE_PARALLEL_DECODE=1
USE_MMAP=1

# --- Safety / Debug ---
ENABLE_DEBUG=0
PRINT_PROMPT=0
