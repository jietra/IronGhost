root ::= ws "{" ws "\"environment\"" ws ":" ws environment ws "," ws "\"runtime\"" ws ":" ws runtime ws "," ws "\"source\"" ws ":" ws json-string ws "}" ws

environment ::= "\"kali\""

runtime ::= "\"python\""

json-string ::= "\"" json-char* "\""

json-char ::= [^"\\\x00-\x1F] | escape

escape ::= "\\" (["\\/bfnrt] | "u" hex hex hex hex)

hex ::= [0-9a-fA-F]

ws ::= [ \t\n\r]*